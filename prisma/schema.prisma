generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum Currency {
  IDR
  USD
}

enum Theme {
  light
  dark
}

enum Horizon {
  h1  @map("1h")
  h6  @map("6h")
  d1  @map("1d")
  d7  @map("7d")
}

enum Trend {
  bullish
  bearish
  sideways
}

enum RoleChat {
  user
  assistant
}

enum ModelType {
  lstm
  transformer
  hybrid
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @db.VarChar(100)
  email         String         @unique @db.VarChar(150)
  password_hash String         @db.Text
  is_verified   Boolean        @default(false)
  role          Role           @default(user)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt

  settings      UserSettings?
  predictions   Prediction[]
  sessions      ChatSession[]
  modelsTrained ModelVersion[] @relation("TrainedBy")
}

model UserSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  user_id                String   @unique @db.Uuid
  currency               Currency @default(IDR)
  theme                  Theme    @default(light)
  price_alert_high       Decimal? @db.Decimal(18, 2)
  price_alert_low        Decimal? @db.Decimal(18, 2)
  default_predict_horizon Horizon @default(d1)
  notification_email     Boolean  @default(true)
  notification_browser   Boolean  @default(true)
  updated_at             DateTime @updatedAt

  user                   User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model BitcoinPrice {
  id          BigInt   @id @default(autoincrement())
  timestamp   DateTime @unique
  open        Decimal  @db.Decimal(18, 2)
  high        Decimal  @db.Decimal(18, 2)
  low         Decimal  @db.Decimal(18, 2)
  close       Decimal  @db.Decimal(18, 2)
  volume      Decimal  @db.Decimal(24, 4)
  market_cap  Decimal  @db.Decimal(24, 2)
  source      String   @db.VarChar(50)
}

model Prediction {
  id               String       @id @default(uuid()) @db.Uuid
  user_id          String?      @db.Uuid
  model_version_id String       @db.Uuid
  predict_horizon  Horizon
  predicted_price  Decimal      @db.Decimal(18, 2)
  confidence_score Decimal      @db.Decimal(5, 4)
  trend            Trend
  explanation_text String       @db.Text
  actual_price     Decimal?     @db.Decimal(18, 2)
  accuracy         Decimal?     @db.Decimal(5, 4)
  created_at       DateTime     @default(now())

  user             User?        @relation(fields: [user_id], references: [id], onDelete: SetNull)
  modelVersion     ModelVersion @relation(fields: [model_version_id], references: [id])
}

model ChatSession {
  id         String        @id @default(uuid()) @db.Uuid
  user_id    String        @db.Uuid
  title      String        @db.VarChar(200)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt

  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages   ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(uuid()) @db.Uuid
  session_id    String      @db.Uuid
  role          RoleChat
  content       String      @db.Text
  context_price Decimal?    @db.Decimal(18, 2)
  model_used    String?     @db.VarChar(100)
  created_at    DateTime    @default(now())

  session       ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model ModelVersion {
  id                    String        @id @default(uuid()) @db.Uuid
  version_name          String        @db.VarChar(50)
  model_type            ModelType
  huggingface_model_id  String?       @db.VarChar(200)
  training_dataset_start DateTime     @db.Date
  training_dataset_end   DateTime     @db.Date
  mape_score            Decimal?      @db.Decimal(6, 4)
  accuracy_score        Decimal?      @db.Decimal(5, 4)
  is_active             Boolean       @default(false)
  model_file_path       String?       @db.Text
  trained_by            String?       @db.Uuid
  created_at            DateTime      @default(now())

  trainer               User?         @relation("TrainedBy", fields: [trained_by], references: [id])
  predictions           Prediction[]
  trainingLogs          TrainingLog[]
}

model TrainingLog {
  id               String       @id @default(uuid()) @db.Uuid
  model_version_id String       @db.Uuid
  epoch            Int
  train_loss       Decimal      @db.Decimal(10, 6)
  val_loss         Decimal      @db.Decimal(10, 6)
  learning_rate    Decimal      @db.Decimal(10, 8)
  duration_seconds Int
  created_at       DateTime     @default(now())

  modelVersion     ModelVersion @relation(fields: [model_version_id], references: [id], onDelete: Cascade)
}
